# ---- API ----
NODE_ENV=development
PORT=3000

# ---- Database (Postgres) ----
# Local docker-compose default; on Railway use the injected DATABASE_URL.
DATABASE_URL=postgresql://akul:akul@localhost:5432/akul_erp?schema=public

# ---- Redis (idempotency cache + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally / S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=akul-erp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h

# ---- Domain config ----
VOLUMETRIC_DIVISOR=5000
