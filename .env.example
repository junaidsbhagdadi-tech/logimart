# ---- API ----
NODE_ENV=development
PORT=3000

# ---- Database (Postgres) — the ONLY external service Logimart needs ----
# Local docker-compose default; hosts (DigitalOcean/Railway) inject their own DATABASE_URL.
DATABASE_URL=postgresql://logimart:logimart@localhost:5432/logimart_erp?schema=public

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h

# ---- Company / domain config (mirror of apps/api/src/config/company.ts) ----
VOLUMETRIC_DIVISOR=5000
COMPANY_GSTIN=TODO_LOGIMART_GSTIN
COMPANY_STATE_CODE=29

# ---- Web portal (apps/web) ----
# In production leave VITE_API_URL UNSET: the API serves the built portal
# same-origin. For split local dev (vite :5180, api :3000) set in apps/web/.env:
#   VITE_API_URL=http://localhost:3000
#
# NOTE: Redis and S3/MinIO are NOT used by the current build. POD photos/labels
# are stored in Postgres (Upload table) — no cache or object store required.
