# ============================================================================
#  Logimart ERP — production environment
#  COPY this file to  apps/api/.env  on the server and fill every CHANGE_ME.
#  (NestJS ConfigModule loads .env from apps/api/ at runtime.)
# ============================================================================

NODE_ENV=production
PORT=3000

# ---- Database (Postgres on this server) ----
# Must match the user/password created in deploy/server-setup.sh
DATABASE_URL=postgresql://logimart:CHANGE_ME_DB_PASS@localhost:5432/logimart_erp?schema=public

# ---- Auth ----
# Generate once:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=12h

# ---- Company / billing identity ----
VOLUMETRIC_DIVISOR=5000
COMPANY_GSTIN=CHANGE_ME_GSTIN
COMPANY_STATE_CODE=29
AWB_PREFIX=L
APP_URL=https://erp.logimart.co.in

# ---- BlueDart integration (OPTIONAL — live tracking / hand-off) ----
# Leave BLANK to disable BlueDart; the ERP runs fine without it.
BLUEDART_BASE_URL=
BLUEDART_AUTH_URL=
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_LICKEY=
BLUEDART_LOGINID=

# ---- DigitalOcean Spaces — POD / signature / stamp image storage ----
# Keeps proof images OUT of Postgres (stored private, served via short-lived presigned URLs).
# Leave BLANK to store images inline in the DB as before (fine for local/dev or a bare box).
# Create a Space in BLR (Bangalore) for India data residency, then a Spaces access key.
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_REGION=blr1
SPACES_BUCKET=CHANGE_ME_BUCKET_NAME
SPACES_KEY=CHANGE_ME_SPACES_ACCESS_KEY
SPACES_SECRET=CHANGE_ME_SPACES_SECRET

# ---- WhatsApp notifications (OPTIONAL) ----
# Leave BLANK to disable WhatsApp messages.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ---- Email provider ----
# PREFERRED on cloud droplets: Brevo HTTPS API (port 443) — bypasses the outbound-SMTP
# block that DigitalOcean and most clouds enforce. Get a free key at brevo.com → SMTP & API → API Keys.
# When BREVO_API_KEY is set it is used instead of SMTP. Sender = SMTP_FROM below.
BREVO_API_KEY=

# ---- Email / SMTP (fallback; only used when BREVO_API_KEY is blank) ----
# Note: outbound SMTP (25/465/587) is BLOCKED by default on DigitalOcean droplets, so SMTP
# will time out there — use Brevo above instead. Leave SMTP_HOST blank to disable SMTP.
SMTP_HOST=mail.logimart.co.in
SMTP_PORT=587
# secure: true only for port 465 (SSL). For 587 (STARTTLS) leave false/blank.
SMTP_SECURE=false
# Login for the mailbox — usually the same as the From address. SET THESE ON THE SERVER.
SMTP_USER=noreply@logimart.co.in
SMTP_PASS=
SMTP_FROM=Logimart <noreply@logimart.co.in>
# Who the daily digest / MIS goes to (comma-separated).
REPORTS_EMAIL=
