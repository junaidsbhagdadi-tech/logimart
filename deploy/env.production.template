# ============================================================================
#  Logimart ERP — production environment
#  COPY this file to  apps/api/.env  on the server and fill every CHANGE_ME.
#  (NestJS ConfigModule loads .env from apps/api/ at runtime.)
# ============================================================================

NODE_ENV=production
PORT=3000

# ---- Database (Postgres on this server) ----
# Must match the user/password created in deploy/server-setup.sh
DATABASE_URL=postgresql://logimart:CHANGE_ME_DB_PASS@localhost:5432/logimart_erp?schema=public

# ---- Auth ----
# Generate once:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=12h

# ---- Company / billing identity ----
VOLUMETRIC_DIVISOR=5000
COMPANY_GSTIN=CHANGE_ME_GSTIN
COMPANY_STATE_CODE=29
AWB_PREFIX=L
APP_URL=https://erp.logimart.co.in

# ---- BlueDart integration (OPTIONAL — live tracking / hand-off) ----
# Leave BLANK to disable BlueDart; the ERP runs fine without it.
BLUEDART_BASE_URL=
BLUEDART_AUTH_URL=
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_LICKEY=
BLUEDART_LOGINID=

# ---- WhatsApp notifications (OPTIONAL) ----
# Leave BLANK to disable WhatsApp messages.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
