// Logimart ERP — core schema
// B2B logistics, MPS-aware (1 Master AWB -> many child pieces), append-only scans.
// Volumetric divisor = 5000 (computed in application code, see shipments.service.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ IDENTITY & RBAC ============================

enum UserRole {
  WAREHOUSE_HANDLER
  DRIVER
  HUB_MANAGER
  FINANCE_EXEC
  CLIENT_ADMIN
  SYS_ADMIN
}

model User {
  id           BigInt    @id @default(autoincrement())
  clientId     BigInt?   // null for internal staff
  client       B2bClient? @relation(fields: [clientId], references: [id])
  fullName     String
  email        String    @unique
  passwordHash String
  role         UserRole
  hubId        BigInt?   // home hub for ops staff
  featureGrants Json?    // super-admin-assigned nav feature keys (route paths). null = role defaults.
  isActive     Boolean   @default(true)
  // ---- Rider/driver identity (role DRIVER) — used by the mobile app's Rider-ID + PIN login ----
  riderCode    String?   @unique // RID001 — the field ID a rider logs into the app with
  pinHash      String?   // bcrypt of the rider's numeric PIN
  phone        String?   // rider mobile
  vehicleNo    String?   // assigned vehicle
  createdAt    DateTime  @default(now())

  scans  ScanEvent[]
  pods   Pod[]
  hub    Hub?       @relation(fields: [hubId], references: [id])

  @@map("users")
}

model Hub {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique // BLR, HYD ...
  name      String
  zone      String
  createdAt DateTime @default(now())

  users          User[]
  originShipments Shipment[] @relation("originHub")
  destShipments   Shipment[] @relation("destHub")

  @@map("hubs")
}

// ============================ B2B CLIENTS / FINANCE ============================

model B2bClient {
  id              BigInt   @id @default(autoincrement())
  legalName       String
  accountCode     String   @unique // ACME001
  gstin           String?
  pan             String?
  addressLine     String?
  city            String?
  pincode         String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  // ---- Xpresion "Personal Information" parity fields ----
  contactPerson   String?
  addressLine2    String?
  state           String?
  tel1            String?
  tel2            String?
  fax             String?
  billingState    String?
  serviceCentre   String?
  origin          String?
  startDate       DateTime?
  aadhaarNo       String?
  dobAadhaar      DateTime?
  passportNo      String?
  tanNo           String?
  invoiceFormat   String?
  email2          String?   // secondary billing email (billing-app parity)
  iecCode         String?
  salesPerson     String?
  accountType     String?   @default("CREDIT") // CREDIT | WALLET
  billingCycle    String?   @default("MONTHLY") // MONTHLY | FORTNIGHTLY
  allowSameGstin  Boolean   @default(false) // permit another customer with the same GSTIN
  customerType    String?   @default("Customer") // Customer | Agent | ...
  registerType    String?   @default("Registered") // Registered | Un Registered | B2B | B2C
  creditLimit     Decimal  @default(0) @db.Decimal(14, 2)
  creditDays      Int      @default(30) // Net 30 / Net 60
  outstandingBal  Decimal  @default(0) @db.Decimal(14, 2)
  walletBalance   Decimal  @default(0) @db.Decimal(14, 2) // prepaid wallet (accountType WALLET) — debited at booking
  isCreditHold    Boolean  @default(false)
  isActive        Boolean  @default(true)
  isOneTime       Boolean  @default(false) // walk-in / ad-hoc, non-contract
  isCash          Boolean  @default(false) // cash customer — no invoices generated
  // Explicit account grouping: a "child" account points to its parent (head office). A client
  // login may book under any account in its group (the parent + all its children). One level deep.
  parentAccountId BigInt?
  parentAccount   B2bClient?  @relation("AccountGroup", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts   B2bClient[] @relation("AccountGroup")
  createdAt       DateTime @default(now())

  users        User[]
  shipments    Shipment[]
  rateCards    RateCard[]
  customerRateCards CustomerRateCard[]
  invoices     Invoice[]
  ledger       LedgerEntry[]
  notes        DebitCreditNote[]
  claims       Claim[]
  addresses    CustomerAddress[]

  @@map("b2b_clients")
}

/// Additional shipper/consignee addresses per customer (Xpresion "Customer Address" tab).
model CustomerAddress {
  id           BigInt    @id @default(autoincrement())
  clientId     BigInt
  contactType  String?   // Shipper | Consignee | Billing | ...
  name         String
  designation  String?
  email        String?
  mobile       String?
  landline     String?
  addressLine1 String?
  addressLine2 String?
  addressLine3 String?
  pincode      String?
  city         String?
  state        String?
  country      String?   @default("India")
  gstNo        String?
  panNo        String?
  aadhaarNo    String?
  iecNo        String?
  adCode       String?
  lutNo        String?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  client B2bClient @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("customer_addresses")
}

/// Per-customer fuel-surcharge (Xpresion "Fuel Surcharges" tab).
/// mode FLAT   -> use `percentage` directly.
/// mode DYNAMIC-> effective % = basePct + (currentDieselPrice - baseFuelPrice) * stepPerRupee
///               (diesel-linked; floored at 0). currentDieselPrice comes from FuelPrice.
model CustomerFuelSurcharge {
  id            BigInt    @id @default(autoincrement())
  clientId      BigInt
  vendor        String?
  product       String?
  destination   String?
  service       String?
  fromDate      DateTime?
  toDate        DateTime?
  mechanism     String?   // links to a Fuel Mechanism master (code); its params override when set
  mode          String    @default("FLAT") // FLAT | DYNAMIC
  percentage    Decimal?  @db.Decimal(6, 2) // flat %
  basePct       Decimal?  @db.Decimal(6, 2) // dynamic: base % at base fuel price
  baseFuelPrice Decimal?  @db.Decimal(8, 2) // dynamic: reference diesel ₹/L
  stepPerRupee  Decimal?  @db.Decimal(6, 3) // dynamic: +X% per ₹1 above base
  maxPct        Decimal?  @db.Decimal(6, 2) // dynamic: safety cap on the effective %
  createdAt     DateTime  @default(now())

  @@index([clientId])
  @@map("customer_fuel_surcharges")
}

/// Current fuel (diesel) price — the variable that drives dynamic fuel surcharges.
/// Latest row by effectiveFrom = the price in force.
model FuelPrice {
  id            BigInt   @id @default(autoincrement())
  fuelType      String   @default("DIESEL")
  price         Decimal  @db.Decimal(8, 2) // ₹ per litre
  effectiveFrom DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())

  @@index([fuelType, effectiveFrom])
  @@map("fuel_prices")
}

/// Per-customer accessorial charges (Xpresion "Other Charges" tab).
model CustomerOtherCharge {
  id           BigInt    @id @default(autoincrement())
  clientId     BigInt
  vendor       String?   // vendor-specific charge (blank = all vendors / SELF)
  chargeDesc   String    // AIRWAYBILL CHARGES | FREIGHT ON VALUE | ...
  fromDate     DateTime?
  toDate       DateTime?
  origin       String?
  product      String?
  destination  String?
  service      String?
  value        Decimal   @db.Decimal(12, 2)
  minimumValue Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())

  @@index([clientId])
  @@map("customer_other_charges")
}

/// Per-customer volumetric divisors (Xpresion "Customer Volumetric" tab).
model CustomerVolumetric {
  id         BigInt   @id @default(autoincrement())
  clientId   BigInt
  product    String?
  vendor     String?
  service    String?
  cft        Decimal  @db.Decimal(10, 2)
  cmDivide   Decimal  @db.Decimal(10, 2)
  inchDivide Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@map("customer_volumetrics")
}

/// Weight-slab tariff (Xpresion "Customer Rate" / ClientRate). A client (or generic
/// when clientId is null) has many slabs across vendor/product/zone/destination/service.
model ClientRateSlab {
  id          BigInt   @id @default(autoincrement())
  clientId    BigInt?
  vendor      String?
  product     String?
  zone        String?
  country     String?
  destination String?
  service     String?
  origin      String?
  originZone  String?
  unit        String?  // KG | PCS | ...
  days        Int?     // committed TAT
  rateType    String   // INITIAL | ADDITIONAL | UPTO | PLUS | PLUSKG
  weight      Decimal  @db.Decimal(10, 3)
  rate        Decimal  @db.Decimal(12, 2)
  fromDate    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@map("client_rate_slabs")
}

/// Revamped rate card (billing-app "eye → rate cards" parity). One card per
/// customer × network (SELF | vendor) × product; mode derived from the PRODUCT master.
/// The card OWNS its zone × weight-slab grid AND all accessorials, so AIR/Surface/vendor
/// naturally carry different FSC/FOV/ODA/etc. Masters drive every dropdown.
model CustomerRateCard {
  id                BigInt    @id @default(autoincrement())
  clientId          BigInt
  client            B2bClient @relation(fields: [clientId], references: [id])
  network           String    @default("SELF")   // SELF | vendorCode (e.g. BLUEDART)
  vendor            String?                        // vendor display name/code when network != SELF
  product           String                         // PRODUCT master code (DP | APEX | SURFACE ...)
  mode              String?                        // AIR | SURFACE | EXPRESS (from PRODUCT master groupType)
  service           String?                        // optional finer service (NDD | SDD | ...)
  label             String?
  // ---- weight / volumetric ----
  volumetricDivisor Decimal   @default(5000) @db.Decimal(10, 2)
  cft               Decimal   @default(0) @db.Decimal(10, 3) // surface CFT factor (0 = divisor only)
  minChargeableKg   Decimal   @default(0) @db.Decimal(10, 3)  // red-required
  minFreight        Decimal   @default(0) @db.Decimal(12, 2)  // red-required
  addlWeightUnitG   Int       @default(1000) // additional weight step (g); 250/500 for DP/TDD/NDD
  // ---- required-for-all config (red fields in the upload) ----
  cityWiseRates     Boolean   @default(false)                 // "City wise rates option"
  cityRates         Json      @default("[]")                  // [{city, perKg, min}] — special ₹/kg by dest city, overrides the zone rate
  rateAboveKg       Decimal?  @db.Decimal(10, 3)              // break point, e.g. 500 kg
  rateAboveKgRate   Decimal?  @db.Decimal(12, 2)              // ₹/kg above the break
  volDiscountPct    Decimal   @default(0) @db.Decimal(6, 2)   // "Volume weight Discount option"
  handlingBands     Json      @default("[]")                  // [{fromKg,toKg,perPcs}] weight-banded per-pcs
  ospCharge         Decimal   @default(0) @db.Decimal(12, 2)  // oversize (air): dim>119cm or pcs>69kg
  charges           Json      @default("{}")                  // master-driven accessorials: { CHARGE_code: { value, min } }
  // ---- standard surcharge heads (customer bill) ----
  awbCharge         Decimal   @default(0) @db.Decimal(12, 2)  // AIRWAYBILL CHARGES (flat / shipment)
  emergencyCharge   Decimal   @default(0) @db.Decimal(12, 2)  // Emergency Situation Surcharge
  environmentCharge Decimal   @default(0) @db.Decimal(12, 2)  // Environmental Surcharge
  // ---- FSC (flat or dynamic diesel-linked) ----
  fuelMode          String    @default("FLAT")  // FLAT | DYNAMIC
  fuelPct           Decimal   @default(0) @db.Decimal(6, 2)   // flat %
  fuelMechanism     String?                                    // FUEL_MECHANISM master code (dynamic)
  // ---- FOV ----
  fovPct            Decimal   @default(0) @db.Decimal(6, 3)
  fovMin            Decimal   @default(0) @db.Decimal(12, 2)
  // ---- ODA ----
  odaFlat           Decimal   @default(0) @db.Decimal(12, 2)
  odaPerKg          Decimal   @default(0) @db.Decimal(12, 2)
  odaMin            Decimal   @default(0) @db.Decimal(12, 2)
  // ---- other accessorials ----
  topayCharge       Decimal   @default(0) @db.Decimal(12, 2)  // applied when payment term = TO_PAY
  apptCharge        Decimal   @default(0) @db.Decimal(12, 2)
  loadingCharge     Decimal   @default(0) @db.Decimal(12, 2)
  unloadingCharge   Decimal   @default(0) @db.Decimal(12, 2)
  docketCharge      Decimal   @default(0) @db.Decimal(12, 2)
  // ---- validity ----
  validFrom         DateTime  @default(now())
  validTo           DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  slabs             CustomerRateCardSlab[]

  @@index([clientId])
  @@index([clientId, network, product])
  @@map("customer_rate_cards")
}

/// Zone × weight-slab cell of a CustomerRateCard. rateType keeps the flexible
/// family (INITIAL | ADDITIONAL | UPTO | PLUS | PLUSKG).
model CustomerRateCardSlab {
  id         BigInt   @id @default(autoincrement())
  rateCardId BigInt
  card       CustomerRateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  originZone String?  // origin zone (origin × dest grid); null = any origin
  zone       String   // destination zone code (DP: A/B/C/OTHER · Apex/Surface: N1..NE3)
  rateType   String   // INITIAL | ADDITIONAL | UPTO | PLUS | PLUSKG | FIRST250 | FIRST500 | ADD500
  weight     Decimal  @db.Decimal(10, 3)
  rate       Decimal  @db.Decimal(12, 2)
  slabOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([rateCardId])
  @@map("customer_rate_card_slabs")
}

/// Vendor bill line (what a vendor charged us) — AWB-wise, for profit/loss vs our sell.
/// Uploaded from the "Vendor bill file" format; matched to our shipment by forwarding AWB.
model VendorBill {
  id            BigInt    @id @default(autoincrement())
  vendorCode    String
  product       String?
  productType   String?
  awb           String    // carrier / vendor AWB
  forwardingNo  String?
  pickupDate    DateTime?
  origin        String?
  destination   String?
  actWeight     Decimal?  @db.Decimal(10, 3)
  chrgWeight    Decimal?  @db.Decimal(10, 3)
  pcs           Int?
  // ---- vendor cost heads ----
  freight       Decimal   @default(0) @db.Decimal(12, 2)
  fs            Decimal   @default(0) @db.Decimal(12, 2) // fuel surcharge
  caf           Decimal   @default(0) @db.Decimal(12, 2)
  awbCharge     Decimal   @default(0) @db.Decimal(12, 2)
  greenTax      Decimal   @default(0) @db.Decimal(12, 2)
  edl           Decimal   @default(0) @db.Decimal(12, 2)
  fov           Decimal   @default(0) @db.Decimal(12, 2)
  tdd           Decimal   @default(0) @db.Decimal(12, 2)
  topay         Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @default(0) @db.Decimal(12, 2)
  totalWithGst  Decimal   @default(0) @db.Decimal(12, 2)
  destPincode   String?
  declaredValue Decimal?  @db.Decimal(14, 2)
  createdAt     DateTime  @default(now())

  @@unique([vendorCode, awb])
  @@index([awb])
  @@map("vendor_bills")
}

// ============================ MASTER AWB (Shipment) ============================

enum ServiceMode {
  AIR_EXPRESS
  AIR_ECONOMY
  ROAD_FTL
  ROAD_PTL
  RAIL
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  PARTIAL
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

// How freight is settled for this consignment.
enum PaymentTerm {
  PREPAID // freight billed to the client account (credit) — the default
  TO_PAY  // "Freight Collect": freight collected from the consignee at delivery
}

// DOD (Draft on Delivery) — the instrument collected before release.
enum DodInstrument {
  CHEQUE
  DD
}

model Shipment {
  id           BigInt         @id @default(autoincrement())
  awb          String         @unique // master AWB, e.g. LMT202600045
  clientId     BigInt
  client       B2bClient      @relation(fields: [clientId], references: [id])
  serviceMode  ServiceMode
  originHubId  BigInt?        // optional — direct city-to-city B2B lanes skip the hubs
  originHub    Hub?           @relation("originHub", fields: [originHubId], references: [id])
  destHubId    BigInt?
  destHub      Hub?           @relation("destHub", fields: [destHubId], references: [id])
  originZone   String
  destZone     String
  pieceCount   Int
  status       ShipmentStatus @default(CREATED)
  // milestone lifecycle code: MAN → PKD → ORD → DPD → DRD → OFD → DLD | UDL
  statusCode   String?        @default("MAN")
  statusAt     DateTime?
  currentLocation String?     // latest scan hub/location (set on ORD/DRD/hub scans)
  podUrl       String?        @db.Text // proof-of-delivery image (data URI), mandatory at DLD
  pickupPodUrl String?        @db.Text // pickup proof image, optional at PKD
  bagCode      String?        // mid-mile bag this shipment is bagged into
  // denormalized aggregate cache; source of truth = pieces
  totalDeadKg  Decimal        @default(0) @db.Decimal(10, 3)
  totalVolKg   Decimal        @default(0) @db.Decimal(10, 3)
  exceptionFlag String?       // shortage / out-of-order anomaly note
  createdAt    DateTime       @default(now())

  // ---- consignment / India compliance ----
  lrNumber       String?   @unique // Lorry Receipt / GC Note number
  declaredValue  Decimal?  @db.Decimal(14, 2) // goods value (e-way bill threshold)
  chargeOverrides Json?    // manual per-shipment charge overrides { CODE: amount } — wins over computed
  hsnCode        String?
  goodsDesc      String?
  consignorGstin String?
  consigneeGstin String?
  consigneeName  String?
  consigneePhone String?  // for delivery notifications
  consigneeAddress String?
  consigneeCity  String?
  destPincode    String?
  isOda          Boolean   @default(false) // out-of-delivery-area destination

  // ---- shipper (sender) — a full party, separate from the billing customer ----
  shipperName     String?
  shipperContact  String?
  shipperAddress1 String?
  shipperAddress2 String?
  shipperPincode  String?
  shipperCity     String?
  shipperState    String?
  shipperPhone    String?
  shipperMobile   String?
  shipperEmail    String?
  shipperCountry  String?
  shipperIec      String?
  shipperGstin    String?
  shipperDocType  String?
  shipperDocNo    String?
  originLocation  String? // origin place (e.g. DELHI), distinct from originZone

  // ---- consignee extras (Xpresion parity) ----
  consigneeContact  String?
  consigneeState    String?
  consigneeCountry  String?
  consigneeIec      String?
  consigneeDocType  String?
  consigneeDocNo    String?

  // ---- services extras ----
  vendor         String?
  service        String?
  shipmentValue  Decimal? @db.Decimal(14, 2)
  isCommercial   Boolean  @default(false)
  isMedical      Boolean  @default(false)
  apptDelivery   Boolean  @default(false) // appointment delivery required
  referenceNo    String?

  vehicleNo      String?
  ftlVehicleType String?   // 8ft | 10ft | 14ft | 17ft | 20ft | 32FT SXL | 32ft MXL
  departureAt    DateTime?
  arrivalAt      DateTime?
  expectedDelivery DateTime? // promised delivery = booking date + zone→zone TAT (ZONE_TAT master)
  manualFreight  Decimal?  @db.Decimal(14, 2) // ad-hoc/one-time rate override
  ewbNo          String?   // e-way bill number
  ewbValidUpto   DateTime?

  // ---- services + accessorial charges (AWB Entry parity) ----
  product        String?   // product/service code from the Product master
  docType        String?   // DOX | NDOX
  chargeWeight   Decimal?  @db.Decimal(10, 3)
  charges        Json?     // [{ code, name, amount }] — accessorials picked from the Charges master

  // ---- carrier hand-off ----
  forwardingAwb  String?   // vendor/carrier AWB entered at hand-off (any vendor); BlueDart auto-fetched once integrated
  forwardingAt   DateTime?
  bdWaybill      String?   // BlueDart waybill (AWB) number returned on hand-off
  bdStatus       String?   // last BlueDart status pulled via tracking
  bdHandedAt     DateTime?

  manifestId     BigInt?   // trip/manifest this consignment is attached to
  deliveryRiderId BigInt?  // rider assigned for last-mile delivery

  // ---- payment terms: Prepaid vs To-Pay (Freight Collect) ----
  paymentTerm        PaymentTerm @default(PREPAID)
  freightToCollect   Decimal?    @db.Decimal(14, 2) // freight to collect from consignee (To-Pay)
  freightCollected   Decimal?    @db.Decimal(14, 2) // freight actually collected at delivery
  freightCollectedAt DateTime?
  freightCollectedById BigInt?

  // ---- DOD (Draft on Delivery): cheque/DD collected BEFORE the shipment is released ----
  isDod            Boolean        @default(false)
  dodAmount        Decimal?       @db.Decimal(14, 2)
  dodInstrument    DodInstrument?
  dodReference     String?        // cheque / DD number
  dodBankName      String?
  dodCollectedAt   DateTime?      // set when the draft is collected (delivery gate)
  dodCollectedById BigInt?
  dodHandedOverAt  DateTime?      // draft handed over to the consignor

  pieces ShipmentPiece[]
  pods   Pod[]
  invoiceLines InvoiceLineItem[]
  notes  DebitCreditNote[]
  claims Claim[]

  @@index([clientId])
  @@map("shipments")
}

// ============================ CHILD BOXES (1 -> many) ============================

enum PieceStatus {
  CREATED
  PICKED_UP
  AT_HUB
  LOADED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  MISSING
  DAMAGED
}

model ShipmentPiece {
  id           BigInt      @id @default(autoincrement())
  shipmentId   BigInt
  shipment     Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  childId      String      @unique // LMT202600045-002 (the scannable identity)
  sequenceNo   Int         // 2 (the "of 5")
  barcodeValue String      // encoded payload for QR / Code128
  deadKg       Decimal     @db.Decimal(10, 3)
  lengthCm     Decimal?    @db.Decimal(8, 2)
  widthCm      Decimal?    @db.Decimal(8, 2)
  heightCm     Decimal?    @db.Decimal(8, 2)
  volKg        Decimal     @default(0) @db.Decimal(10, 3) // L*W*H/5000, set in app code
  status       PieceStatus @default(CREATED)
  // ---- re-weigh / weight audit (revenue-leakage control) ----
  reweighKg     Decimal?   @db.Decimal(10, 3) // actual dead weight caught at hub
  reweighVolKg  Decimal?   @db.Decimal(10, 3) // recomputed volumetric at hub
  reweighedAt   DateTime?
  reweighedById BigInt?

  scans ScanEvent[]

  @@unique([shipmentId, sequenceNo])
  @@index([barcodeValue])
  @@map("shipment_pieces")
}

// ============================ SCAN EVENTS (append-only) ============================

enum ScanCheckpoint {
  PICKUP
  HUB_IN
  HUB_OUT
  LOAD
  UNLOAD
  OUT_FOR_DELIVERY
  DELIVERY
  POD
}

model ScanEvent {
  id            BigInt         @id @default(autoincrement())
  clientEventId String         @unique // device-generated UUID -> idempotency backbone
  pieceId       BigInt
  piece         ShipmentPiece  @relation(fields: [pieceId], references: [id])
  checkpoint    ScanCheckpoint
  scannedById   BigInt
  scannedBy     User           @relation(fields: [scannedById], references: [id])
  hubId         BigInt?
  manifestId    BigInt?
  scannedAt     DateTime       // DEVICE time (logical order)
  receivedAt    DateTime       @default(now()) // SERVER time (arrival)
  deviceSeq     BigInt?        // monotonic per-device counter
  gpsLat        Decimal?       @db.Decimal(9, 6)
  gpsLng        Decimal?       @db.Decimal(9, 6)
  meta          Json           @default("{}")

  @@index([pieceId, scannedAt])
  @@map("scan_events")
}

// ============================ MANIFESTS (vehicle loading) ============================

model Manifest {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique
  vehicleNo  String
  driverId   BigInt?
  fromHubId  BigInt
  toHubId    BigInt
  status     String   @default("open") // open | sealed | arrived
  createdAt  DateTime @default(now())

  @@map("manifests")
}

// ============================ PICKUP REQUESTS ============================

enum PickupStatus {
  REQUESTED
  ASSIGNED
  PICKED
  CANCELLED
}

model PickupRequest {
  id            BigInt       @id @default(autoincrement())
  clientId      BigInt
  pickupAddress String
  city          String?
  pincode       String?
  contactName   String?
  contactPhone  String?
  estPieces     Int          @default(1)
  cargoMode     String?      // AIR | ROAD | TRAIN | FTL | PTL
  invoiceNo     String?
  invoiceDate   DateTime?
  invoiceValue  Decimal?     @db.Decimal(14, 2)
  ewbNo         String?
  notes         String?
  status        PickupStatus @default(REQUESTED)
  assignedRiderId BigInt?
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@map("pickup_requests")
}

// ============================ PROOF OF DELIVERY ============================

model Pod {
  id              BigInt   @id @default(autoincrement())
  shipmentId      BigInt
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  deliveredById   BigInt
  deliveredBy     User     @relation(fields: [deliveredById], references: [id])
  signatureUrl    String?
  stampPhotoUrl   String?
  gpsLat          Decimal  @db.Decimal(9, 6) // mandatory
  gpsLng          Decimal  @db.Decimal(9, 6)
  piecesDelivered Int
  isShort         Boolean  @default(false) // delivered < pieceCount
  deliveredAt     DateTime

  @@map("pods")
}

// ============================ BILLING & FINANCE ============================

model RateCard {
  id            BigInt    @id @default(autoincrement())
  clientId      BigInt
  client        B2bClient @relation(fields: [clientId], references: [id])
  originZone    String
  destZone      String
  serviceMode   ServiceMode
  perKgRate     Decimal   @db.Decimal(10, 2)
  minCharge     Decimal   @default(0) @db.Decimal(10, 2)
  fuelPct       Decimal   @default(0) @db.Decimal(5, 2)
  // ---- surcharges (all optional / configurable) ----
  fovPct        Decimal   @default(0) @db.Decimal(6, 3)  // % of declared value
  fovMin        Decimal   @default(0) @db.Decimal(10, 2)
  odaFlat       Decimal   @default(0) @db.Decimal(10, 2)
  odaPerKg      Decimal   @default(0) @db.Decimal(10, 2)
  odaMin        Decimal   @default(0) @db.Decimal(10, 2)
  docketCharge  Decimal   @default(0) @db.Decimal(10, 2)
  handlingCharge Decimal  @default(0) @db.Decimal(10, 2)
  effectiveFrom DateTime  @db.Date

  @@unique([clientId, originZone, destZone, serviceMode, effectiveFrom])
  @@map("rate_cards")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  DISPUTED
  LOCKED
}

model Invoice {
  id          BigInt        @id @default(autoincrement())
  clientId    BigInt
  client      B2bClient     @relation(fields: [clientId], references: [id])
  invoiceNo   String        @unique
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  tax         Decimal       @default(0) @db.Decimal(14, 2) // total GST
  cgst        Decimal       @default(0) @db.Decimal(14, 2)
  sgst        Decimal       @default(0) @db.Decimal(14, 2)
  igst        Decimal       @default(0) @db.Decimal(14, 2)
  placeOfSupply String?
  sacCode     String?       @default("9968") // GTA / transport service SAC
  total       Decimal       @default(0) @db.Decimal(14, 2)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime      @db.Date
  issuedAt    DateTime?
  // ---- GST e-invoice (IRP) ----
  irn         String?       // Invoice Reference Number
  irnAckNo    String?
  irnAckedAt  DateTime?

  lines  InvoiceLineItem[]
  ledger LedgerEntry[]

  @@map("invoices")
}

model InvoiceLineItem {
  id            BigInt   @id @default(autoincrement())
  invoiceId     BigInt
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipmentId    BigInt
  shipment      Shipment @relation(fields: [shipmentId], references: [id])
  chargeableKg  Decimal  @db.Decimal(10, 3) // max(dead, vol) of DELIVERED pieces
  amount        Decimal  @db.Decimal(14, 2) // all-in pre-GST line total = freight + fuel + otherCharges
  freight       Decimal  @default(0) @db.Decimal(14, 2) // base freight (the invoice "Amount" column)
  fuel          Decimal  @default(0) @db.Decimal(14, 2) // fuel surcharge portion
  otherCharges  Decimal  @default(0) @db.Decimal(14, 2) // FOV/ODA/docket/handling/etc.
  breakup       Json?    // full head-by-head charge breakdown as billed (freight/fuel/fov/oda/docket/handling/awb/…)
  isDisputed    Boolean  @default(false) // locks THIS line, not the whole invoice
  disputeReason String?

  @@map("invoice_line_items")
}

model LedgerEntry {
  id           BigInt   @id @default(autoincrement())
  clientId     BigInt
  client       B2bClient @relation(fields: [clientId], references: [id])
  invoiceId    BigInt?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id])
  entryType    String   // charge | payment | adjustment | credit_note
  amount       Decimal  @db.Decimal(14, 2) // +debit / -credit to receivable
  balanceAfter Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  @@map("ledger_entries")
}

// ============================ PINCODE DIRECTORY ============================

enum Region {
  NORTH
  SOUTH
  EAST
  WEST
  NORTHEAST
}

/// Atomic counters (e.g. AWB sequence) — row-locked increment avoids race collisions.
model Counter {
  name  String @id
  value BigInt @default(0)

  @@map("counters")
}

model Pincode {
  pincode String  @id
  city    String
  state   String
  region  Region?
  tier    Int?    // 1 | 2 | 3
  isOda   Boolean @default(false)
  // ---- zone mapping (per product) + EDL, from the PINCODE MAPPING upload ----
  serviceCentre String?  // e.g. ANT
  areaName      String?  // e.g. ANTARIKSH BHAVAN
  dpZone        String?  // A | B | C | OTHER  (Intracity | Within Region | Metro | ROI)
  surfaceZone   String?  // N1..NE3
  apexZone      String?  // N1..NE3
  ecomZone      String?
  edl           String?  @default("Regular") // Regular | EDL (out-of-coverage → ODA charge)
  edlDistanceKm Int?     // km from nearest service centre — drives the EDL matrix lookup
  tatHours      Int?

  @@index([city])
  @@index([region])
  @@map("pincodes")
}

/// EDL (= ODA / "Extra Delivery Location") matrix — one standard table per vendor/network.
/// Charge = cell at (km-band × chargeable-weight-band). Fallback rules for beyond-range /
/// NE-JCK live in a MasterEntry(type 'EDL_RULE', code = network).
model EdlRate {
  id        BigInt   @id @default(autoincrement())
  network   String   @default("SELF") // vendor code (e.g. BLUEDART) or SELF
  kmFrom    Int
  kmTo      Int
  wtFromKg  Int
  wtToKg    Int
  rate      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([network])
  @@map("edl_rates")
}

/// Serviceability coverage: which pincodes are served, by the SELF network or a vendor.
/// A pincode can appear once per network (self + one row per vendor), so the same
/// destination can be delivered in-house OR handed to a specific carrier.
model ServiceablePincode {
  id        BigInt   @id @default(autoincrement())
  pincode   String
  city      String?
  state     String?
  network   String   @default("SELF") // 'SELF' (own network) or a vendor name/code
  vendorId  BigInt?
  mode      String?  // SURFACE | AIR
  tatDays   Int?     // committed transit days
  isOda     Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([pincode, network])
  @@index([pincode])
  @@index([network])
  @@map("serviceable_pincodes")
}

// Generic master-data table — one row per entry across many master types
// (Zone, Country, State, Product, Product Type, Charge, Destination, Sales Exec …).
// `attrs` holds the type-specific extra fields as JSON so new masters need no schema change.
model MasterEntry {
  id        BigInt   @id @default(autoincrement())
  type      String   // ZONE | COUNTRY | STATE | PRODUCT | PRODUCT_TYPE | CHARGE | DESTINATION | SALES_EXEC | INDUSTRY | CONTENT | INSTRUCTION | BANK | FLIGHT
  code      String
  name      String
  attrs     Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, code])
  @@index([type])
  @@map("master_entries")
}

// Flat operational scan log (Pickup In-scan, Out-scan, Manifest In-scan,
// Un-delivery, Miss-route). Independent of the piece-level event-sourced ScanEvent.
model ScanLog {
  id            BigInt   @id @default(autoincrement())
  awb           String
  eventType     String   // PICKUP_IN | OUT_SCAN | MANIFEST_IN | UNDELIVERED | MISROUTE
  serviceCenter String?
  scannedById   BigInt?
  remark        String?
  scanAt        DateTime @default(now())

  @@index([awb])
  @@index([eventType])
  @@map("scan_logs")
}

// Cached carrier auth token (e.g. BlueDart JWT, valid 24h). Postgres-backed so
// it is shared across API instances instead of re-authing per request.
model IntegrationToken {
  provider  String   @id // 'BLUEDART'
  token     String   @db.Text
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("integration_tokens")
}

// ============================ FTL RATES (per vehicle type / trip) ============================

model FtlRate {
  id            BigInt      @id @default(autoincrement())
  clientId      BigInt?     // null = generic / one-time
  originZone    String
  destZone      String
  vehicleType   String      // 8ft | 10ft | 14ft | 17ft | 20ft | 32FT SXL | 32ft MXL
  flatRate      Decimal     @db.Decimal(12, 2) // per-trip freight
  fuelPct       Decimal     @default(0) @db.Decimal(5, 2)
  gstPct        Decimal     @default(18) @db.Decimal(5, 2) // GST % on the trip (GTA may differ, e.g. 5/12/18)
  effectiveFrom DateTime    @db.Date

  @@index([clientId, originZone, destZone, vehicleType])
  @@map("ftl_rates")
}

// ============================ VENDOR MASTER + PAYMENTS ============================

model Vendor {
  id           BigInt   @id @default(autoincrement())
  name         String
  modes        String   // comma list: FTL,PTL,AIR,TRAIN
  gstin        String?
  pan          String?
  addressLine  String?
  city         String?
  state        String?
  pincode      String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  // ---- Xpresion Vendor-master parity ----
  vendorCode   String?  @unique
  contactPerson String?
  addressLine2 String?
  tel1         String?
  tel2         String?
  fax          String?
  website      String?
  mode         String?  // single primary mode
  fuelHead     String?
  currency     String?  @default("INR")
  origin       String?
  vendorZip    String?
  isGlobal     Boolean  @default(false)
  gstEnabled   Boolean  @default(false)
  volRoundOff  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  payments VendorPayment[]

  @@map("vendors")
}

/// Vendor ↔ service ↔ billing-vendor mapping with weight bands (Xpresion "Service Mapping").
model ServiceMapping {
  id            BigInt   @id @default(autoincrement())
  vendor        String
  serviceType   String   // SELF | DHL | ARAMEX | ...
  billingVendor String?
  minWeight     Decimal  @default(0) @db.Decimal(10, 3)
  maxWeight     Decimal  @default(0) @db.Decimal(10, 3)
  vendorLink    String?  // integration link key (AFTERSHIP | BLUEDART | DHL | ...)
  isSinglePiece Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([vendor])
  @@map("service_mappings")
}

model VendorPayment {
  id        BigInt   @id @default(autoincrement())
  vendorId  BigInt
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  tds       Decimal  @default(0) @db.Decimal(14, 2) // TDS deducted (194C) for 26Q
  kind      String   // advance | settlement
  status    String   @default("pending") // pending | paid
  reference String?  // AWB / trip / invoice ref
  notes     String?
  createdAt DateTime @default(now())

  @@index([vendorId, status])
  @@map("vendor_payments")
}

// ============================ SALES / CRM ============================

enum LeadStage {
  NEW
  MEETING
  QUOTED
  WON
  LOST
}

model Lead {
  id               BigInt    @id @default(autoincrement())
  companyName      String
  contactName      String?
  phone            String?
  email            String?
  salesperson      String?
  services         String?   // FTL,PTL,AIR,TRAIN
  stage            LeadStage @default(NEW)
  potentialVolume  String?   // free text e.g. "20 trucks/mo"
  potentialRevenue Decimal?  @db.Decimal(14, 2)
  nextFollowup     DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  quotations Quotation[]

  @@index([stage, createdAt])
  @@map("leads")
}

model Quotation {
  id         BigInt   @id @default(autoincrement())
  leadId     BigInt?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  service    String   // FTL | PTL | AIR | TRAIN
  lane       String?
  amount     Decimal  @db.Decimal(14, 2)
  validUntil DateTime?
  status     String   @default("open") // open | accepted | rejected
  notes      String?
  createdAt  DateTime @default(now())

  @@map("quotations")
}

// ============================ TESTER FEEDBACK ============================

model Feedback {
  id        BigInt   @id @default(autoincrement())
  userName  String?
  role      String?
  page      String?
  category  String?  // change | add | remove | bug | other
  rating    Int?     // 1-5
  message   String
  status    String   @default("open") // open | reviewed
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("feedback")
}

// ============================ UPLOADS (POD photos / signatures) ============================
// Stored in Postgres for persistence without external object storage. Served
// via GET /api/v1/uploads/:id. Fine for POD-scale images; move to S3/R2 at volume.

model Upload {
  id        BigInt   @id @default(autoincrement())
  kind      String   // pod_signature | pod_stamp
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("uploads")
}

// ============================ NOTIFICATIONS ============================

model Notification {
  id         BigInt   @id @default(autoincrement())
  channel    String   // sms | whatsapp | email | inapp
  recipient  String   // phone / email / role
  kind       String   // shortage | pod | exception | invoice | delivery
  shipmentId BigInt?
  awb        String?
  message    String
  status     String   @default("queued") // queued | sent | failed
  createdAt  DateTime @default(now())

  @@index([kind, createdAt])
  @@map("notifications")
}

// ============================ DEBIT / CREDIT NOTES ============================
// One model for both. DEBIT = extra charge to the client (weight discrepancy,
// demurrage, rate correction). CREDIT = money back (goodwill, claim settlement,
// billing error). Posts to the client ledger like an invoice / payment does.

model DebitCreditNote {
  id         BigInt     @id @default(autoincrement())
  noteNo     String     @unique // DN-ACME001-00007 / CN-...
  kind       String     // DEBIT | CREDIT
  clientId   BigInt
  client     B2bClient  @relation(fields: [clientId], references: [id])
  shipmentId BigInt?
  shipment   Shipment?  @relation(fields: [shipmentId], references: [id])
  invoiceId  BigInt?    // optional link to the invoice being corrected
  reason     String     // weight_discrepancy | demurrage | rate_correction | damage_claim | goodwill | billing_error | other
  narration  String?
  subtotal   Decimal    @db.Decimal(14, 2)
  tax        Decimal    @default(0) @db.Decimal(14, 2)
  cgst       Decimal    @default(0) @db.Decimal(14, 2)
  sgst       Decimal    @default(0) @db.Decimal(14, 2)
  igst       Decimal    @default(0) @db.Decimal(14, 2)
  total      Decimal    @db.Decimal(14, 2)
  status     String     @default("issued") // issued | settled | cancelled
  createdById BigInt?
  createdAt  DateTime   @default(now())

  @@index([clientId, createdAt])
  @@map("debit_credit_notes")
}

// ============================ CLAIMS & INSURANCE ============================

model Claim {
  id             BigInt    @id @default(autoincrement())
  claimNo        String    @unique
  clientId       BigInt
  client         B2bClient @relation(fields: [clientId], references: [id])
  shipmentId     BigInt?
  shipment       Shipment? @relation(fields: [shipmentId], references: [id])
  awb            String?
  type           String    // damage | loss | shortage | delay
  declaredValue  Decimal?  @db.Decimal(14, 2)
  claimedAmount  Decimal   @db.Decimal(14, 2)
  approvedAmount Decimal?  @db.Decimal(14, 2)
  status         String    @default("open") // open | under_review | approved | rejected | settled | closed
  description    String?
  resolution     String?
  noteId         BigInt?   // credit note raised on settlement
  createdById    BigInt?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
  @@map("claims")
}

// Monthly vendor-deduction register (Claims & Insurance): amounts deducted from vendors for
// service failures, keyed on the AWB. Columns mirror the ops "Monthly deduction detail" sheet.
model VendorDeduction {
  id            BigInt    @id @default(autoincrement())
  awb           String                                  // AWB no (mandatory)
  vendorName    String                                  // Vendor name (mandatory)
  vendorAcCode  String?                                 // Vendor A/c code (mandatory)
  pickupDate    DateTime?                               // pickup date (mandatory)
  deliveryDate  DateTime?                               // delivery date (optional)
  emailCommDate DateTime?                               // email communication date (mandatory)
  madeToNames   String?                                 // "made to" names (mandatory)
  reason        String?                                 // reason for deduction (mandatory)
  amount        Decimal   @default(0) @db.Decimal(14, 2) // deduction amount (mandatory)
  attachment    String?                                 // pic / email comm — link or reference (mandatory)
  customerCode  String?                                 // Customer Code (mandatory)
  periodMonth   String?                                 // YYYY-MM bucket for the monthly view
  createdById   BigInt?
  createdAt     DateTime  @default(now())

  @@index([periodMonth])
  @@index([awb])
  @@map("vendor_deductions")
}

// ============================ DOCUMENT / KYC VAULT ============================
// Metadata row; the bytes live in Upload (kind='document'). Polymorphic link to
// any entity (client / vendor / shipment) via entityType + entityId.

model Document {
  id         BigInt    @id @default(autoincrement())
  entityType String    // client | vendor | shipment
  entityId   BigInt
  docType    String    // gst | pan | agreement | kyc | insurance | rate_contract | other
  label      String?
  uploadId   BigInt    // -> Upload.id
  expiresAt  DateTime?
  status     String    @default("active") // active | expired | archived
  createdById BigInt?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@map("documents")
}

// ============================ AUDIT TRAIL ============================
// Append-only log of mutating API calls (who changed what, when).

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?
  userName  String?
  role      String?
  method    String   // POST | PATCH | PUT | DELETE
  path      String
  action    String   // create | update | delete | other
  entity    String?  // derived from path, e.g. clients / shipments
  entityId  String?
  status    Int      // HTTP status
  summary   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

/// Archived legacy data (old-system invoices/PODs/zips). Super-admin only. Small files stored
/// inline as data URI; large archives reference an external link.
model ArchiveItem {
  id           BigInt   @id @default(autoincrement())
  title        String
  category     String?  // Invoices | PODs | Manifests | Ledgers | Other
  fiscalYear   String?  // e.g. 2022-23
  note         String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  fileData     String?  @db.Text // small files as data URI
  fileUrl      String?  // external link (Drive / S3 / Spaces) for large archives
  uploadedById BigInt?
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([fiscalYear])
  @@map("archive_items")
}
